# Copy this file to camera-bridge/.env. Never commit the private .env file.
# Default setup: DroidCam over USB on Windows, plus ESP32 over USB Serial.
# Start DroidCam Client and verify the phone video before running the bridge.
CAMERA_SOURCE=webcam
# 1 was verified on the project laptop. Other laptops must confirm their own index.
CAMERA_INDEX=1
# auto, dshow or msmf; this Windows DroidCam setup was verified with msmf.
# Windows must use opencv-python from requirements, not opencv-python-headless.
CAMERA_BACKEND=msmf
# Discard virtual-camera startup frames once, before the first snapshot (inside capture timeout).
CAMERA_WARMUP_SECONDS=1.5
# Optional alternative: set CAMERA_SOURCE=phone and enter a JPEG snapshot URL here.
# Example only: http://192.168.1.15:8080/shot.jpg (not needed for DroidCam USB).
PHONE_IP_WEBCAM_URL=
# Local file path, used only when CAMERA_SOURCE=video. Never used for real conveyor control.
CAMERA_VIDEO_PATH=
# REQUIRED: replace COM3 with the ESP32 port selected in Arduino IDE / Device Manager.
SERIAL_PORT=COM3
SERIAL_BAUD_RATE=115200
CAMERA_ID=phone_cam01
CLOUD_INFER_URL=https://autosort-iot-java.onrender.com/infer
# REQUIRED: obtain the existing device key privately from the project owner.
# It must match the cloud service; it is NOT the admin/operator login password.
DEVICE_API_KEY=replace_with_private_device_key_from_cloud_configuration
# Capture + HTTP retries share this per-fruit deadline. Coordinate with firmware.
# USB firmware watchdog is 30s; this setting must be <=25s before arming.
JOB_TIMEOUT_SECONDS=20
CAPTURE_TIMEOUT_SECONDS=5
CLOUD_REQUEST_TIMEOUT_SECONDS=5
CLOUD_MAX_ATTEMPTS=3
# Startup wakes the cloud before accepting a fruit; no model MOCK is accepted.
STARTUP_TIMEOUT_SECONDS=90
# Durable trigger history defaults to camera-bridge/.local/bridge-state.sqlite3.
# Keep it across restarts. BRIDGE_STATE_PATH can override it with a local path.
