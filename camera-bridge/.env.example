# Camera is a phone running a JPEG snapshot server, not ESP32-CAM.
PHONE_IP_WEBCAM_URL=http://192.168.1.15:8080/shot.jpg
SERIAL_PORT=COM3
SERIAL_BAUD_RATE=115200
CAMERA_ID=phone_cam01
CLOUD_INFER_URL=https://autosort-iot.onrender.com/infer
DEVICE_API_KEY=replace_with_private_device_key_from_cloud_configuration
# Capture + HTTP retries share this per-fruit deadline. Coordinate with firmware.
JOB_TIMEOUT_SECONDS=20
CAPTURE_TIMEOUT_SECONDS=5
CLOUD_REQUEST_TIMEOUT_SECONDS=5
CLOUD_MAX_ATTEMPTS=3
# Startup wakes the cloud before accepting a fruit; no model MOCK is accepted.
STARTUP_TIMEOUT_SECONDS=90
# Optional: durable trigger history. Keep it across restarts.
# BRIDGE_STATE_PATH=D:/AutoSort IoT/camera-bridge/.local/bridge-state.sqlite3
