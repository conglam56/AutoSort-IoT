# Local development only. Generate separate random secrets (URL-safe characters).
POSTGRES_PASSWORD=replace_with_random_database_password
DATABASE_URL=postgresql://autosort:replace_with_random_database_password@127.0.0.1:5433/autosort
DEVICE_API_KEY=replace_with_a_random_device_key_at_least_32_characters
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Production: COOKIE_SECURE=true, HTTPS origins, managed PostgreSQL URL with sslmode=require.
