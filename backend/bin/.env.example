DATABASE_URL=postgresql://autosort:replace_with_database_password@127.0.0.1:5433/autosort
POSTGRES_PASSWORD=replace_with_database_password
DATABASE_SSLMODE=disable
DEVICE_API_KEY=replace_with_a_private_device_key_at_least_32_characters
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
PORT=8000
# First use only; existing accounts are never overwritten.
INITIALIZE_DATABASE=true
MIGRATE_DATABASE=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace_with_private_admin_password
# Windows example; on Linux/macOS use the venv's bin/python.
PYTHON_BIN=cloud-ai/.venv312/Scripts/python.exe
AI_WORKER_PATH=cloud-ai/worker.py
AI_MODEL_DIR=cloud-ai/model
